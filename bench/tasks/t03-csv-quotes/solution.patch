-        fields.append(raw)
+    value = []
+    quoted = False
+    i = 0
+    while i < len(text):
+        ch = text[i]
+        if quoted:
+            if ch != '"':
+                value.append(ch)
+            elif text[i + 1:i + 2] == '"':
+                value.append('"')
+                i += 1
+            else:
+                quoted = False
+        elif ch == '"' and not value:
+            quoted = True
+        elif ch == delimiter:
+            fields.append(''.join(value))
+            value = []
+        else:
+            value.append(ch)
+        i += 1
+    fields.append(''.join(value))
