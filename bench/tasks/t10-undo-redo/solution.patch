@@ -0,0 +1,66 @@
+"""A bounded undo and redo history for a text buffer."""
+
+
+class Step:
+    """One change to a text: at `position`, `removed` was taken out and `inserted` was put in its place.
+
+    `cursor_before` and `cursor_after` are for whoever made the step, to keep where its cursor was. They stay `None`
+    when nobody does.
+    """
+
+    __slots__ = ('position', 'removed', 'inserted', 'cursor_before', 'cursor_after')
+
+    def __init__(self, position, removed, inserted):
+        self.position = position
+        self.removed = removed
+        self.inserted = inserted
+        self.cursor_before = None
+        self.cursor_after = None
+
+
+class History:
+    """Remembers the newest `limit` steps. A step is either done, and can be undone, or undone, and can be redone."""
+
+    def __init__(self, limit=100):
+        if isinstance(limit, bool) or not isinstance(limit, int) or limit < 0:
+            raise ValueError('the history limit must be a whole number of at least 0')
+        self.limit = limit
+        self._done = []         # oldest first
+        self._undone = []       # the step undone last is at the end
+
+    @property
+    def can_undo(self):
+        return bool(self._done)
+
+    @property
+    def can_redo(self):
+        return bool(self._undone)
+
+    @property
+    def newest(self):
+        """The step that `undo` would take back, or `None`."""
+        return self._done[-1] if self._done else None
+
+    def record(self, step):
+        """Add a new step. Nothing can be redone after it, and the oldest step goes when there are too many."""
+        self._undone.clear()
+        self._done.append(step)
+        extra = len(self._done) - self.limit
+        if extra > 0:
+            del self._done[:extra]
+
+    def undo(self):
+        """Move the newest done step to the undone ones and return it, or `None` when there is none."""
+        if not self._done:
+            return None
+        step = self._done.pop()
+        self._undone.append(step)
+        return step
+
+    def redo(self):
+        """Move the step that was undone last back to the done ones and return it, or `None` when there is none."""
+        if not self._undone:
+            return None
+        step = self._undone.pop()
+        self._done.append(step)
+        return step
