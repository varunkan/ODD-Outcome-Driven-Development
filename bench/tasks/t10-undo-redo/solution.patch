     # Editing at the cursor
 
+    def _edit(self, change):
+        """Run `change`, which edits the buffer and moves the cursor, and keep both cursors with the step it made."""
+        before, newest = self.cursor, self.buffer.history.newest
+        result = change()
+        step = self.buffer.history.newest
+        if step is not None and step is not newest:
+            step.cursor_before, step.cursor_after = before, self.cursor
+        return result
+
