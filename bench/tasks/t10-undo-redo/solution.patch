-        start = max(0, self.cursor - count)
-        removed = self.buffer.delete(start, self.cursor)
-        self.cursor = start
-        return removed
+        def change():
+            start = max(0, self.cursor - count)
+            removed = self.buffer.delete(start, self.cursor)
+            self.cursor = start
+            return removed
+        return self._edit(change)
 
     def delete_forward(self, count=1):
         """Remove up to `count` characters after the cursor and return them. The cursor stays where it is."""
-        end = min(len(self.buffer), self.cursor + count)
-        return self.buffer.delete(self.cursor, end)
+        def change():
+            end = min(len(self.buffer), self.cursor + count)
+            return self.buffer.delete(self.cursor, end)
+        return self._edit(change)
+
+    # Undo and redo
+
+    def undo(self):
+        """Take back the newest step and put the cursor where it was before that step. False when there is none."""
+        step = self.buffer.undo_step()
+        if step is None:
+            return False
+        self._return_to(step.cursor_before)
+        return True
+
+    def redo(self):
+        """Redo the step that was undone last and put the cursor where it was after that step. False when there is
+        none."""
+        step = self.buffer.redo_step()
+        if step is None:
+            return False
+        self._return_to(step.cursor_after)
+        return True
+
+    def _return_to(self, cursor):
+        """Go to a cursor kept with a step. A step made on the buffer directly has none: stay, but inside the text."""
+        self.move_to(self.cursor if cursor is None else cursor)
diff --git a/tests/test_buffer.py b/tests/test_buffer.py
index acca36b..dc2acb5 100644
--- a/tests/test_buffer.py
+++ b/tests/test_buffer.py
@@ -30,6 +30,40 @@ class TextBufferTests(unittest.TestCase):
                 edit()
         self.assertEqual(buffer.text, 'hello')
 
+    def test_changes_are_undone_and_redone(self):
+        buffer = TextBuffer('hello')
+        buffer.append(' world')
+        buffer.replace(0, 5, 'HELLO')
+        buffer.insert(0, '')
+        self.assertTrue(buffer.undo())
+        self.assertEqual(buffer.text, 'hello world')
+        self.assertTrue(buffer.can_undo and buffer.can_redo)
+        self.assertTrue(buffer.undo())
+        self.assertEqual(buffer.text, 'hello')
+        self.assertFalse(buffer.undo())
+        self.assertTrue(buffer.redo())
+        buffer.delete(0, 1)
+        self.assertFalse(buffer.redo())
+        self.assertEqual(buffer.text, 'ello world')
+        with self.assertRaises(IndexError):
+            buffer.delete(0, 99)
+        self.assertTrue(buffer.undo())
+        self.assertEqual(buffer.text, 'hello world')
+
+    def test_history_is_limited(self):
+        buffer = TextBuffer(history_limit=2)
+        for letter in 'abc':
+            buffer.append(letter)
+        self.assertEqual([buffer.undo(), buffer.undo(), buffer.undo()], [True, True, False])
+        self.assertEqual(buffer.text, 'a')
+        self.assertEqual(buffer.history_limit, 2)
+        off = TextBuffer('x', history_limit=0)
+        off.append('y')
+        self.assertFalse(off.can_undo)
+        for bad in (-1, 2.5, '10', None, True):
+            with self.assertRaises(ValueError):
+                TextBuffer(history_limit=bad)
+
     def test_lines_and_search(self):
         buffer = TextBuffer('one\ntwo\n\nfour')
         self.assertEqual(buffer.lines(), ['one', 'two', '', 'four'])
