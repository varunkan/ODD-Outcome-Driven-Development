diff --git a/tests/test_paginator.py b/tests/test_paginator.py
index 2110542..92ef88f 100644
--- a/tests/test_paginator.py
+++ b/tests/test_paginator.py
@@ -48,6 +48,18 @@ class PaginatorTests(unittest.TestCase):
         with self.assertRaises(PageNotFound):
             nothing.page(2)
 
+    def test_a_list_that_divides_evenly_has_no_empty_last_page(self):
+        even = Paginator(list(range(1, 21)), per_page=10)
+        self.assertEqual(even.num_pages, 2)
+        self.assertEqual(even.last_page().items, list(range(11, 21)))
+        self.assertTrue(even.page(1).has_next)
+        self.assertFalse(even.page(2).has_next)
+        self.assertEqual([len(page) for page in even.pages()], [10, 10])
+        with self.assertRaises(PageNotFound):
+            even.page(3)
+        self.assertEqual(Paginator(list(range(10)), per_page=10).num_pages, 1)
+        self.assertEqual(Paginator([1, 2, 3], per_page=1).num_pages, 3)
+
     def test_the_page_an_item_is_on(self):
         self.assertEqual([self.results.page_of(position) for position in (1, 10, 11, 20, 21, 25)],
                          [1, 1, 2, 2, 3, 3])
