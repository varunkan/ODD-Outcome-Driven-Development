diff --git a/paging/paginator.py b/paging/paginator.py
index e09f932..1874a33 100644
--- a/paging/paginator.py
+++ b/paging/paginator.py
@@ -42,7 +42,7 @@ class Page:
 
     @property
     def has_next(self):
-        return self.number * self.paginator.per_page <= self.paginator.count
+        return self.number < self.paginator.num_pages
 
     @property
     def previous_number(self):
@@ -73,8 +73,12 @@ class Paginator:
 
     @property
     def num_pages(self):
-        """How many pages there are. An empty list still has one page, with nothing on it."""
-        return self.count // self.per_page + 1
+        """How many pages there are: every page but the last is full, and the last one is never empty.
+
+        The one exception is an empty list, which still has one page, with nothing on it.
+        """
+        full, rest = divmod(self.count, self.per_page)
+        return max(1, full + (1 if rest else 0))
 
     @property
     def page_range(self):
