+    def reserve(self, sku, quantity, ref):
+        """Hold ``quantity`` units of ``sku`` for the order ``ref``. Adds to what the order already holds."""
+        self.item(sku)
+        whole_positive(quantity)
+        available = self.available(sku)
+        if quantity > available:
