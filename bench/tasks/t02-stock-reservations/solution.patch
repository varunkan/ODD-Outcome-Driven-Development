+
+    def release(self, ref):
+        """Drop everything held for the order ``ref``. Returns the number of units freed, 0 when it held none."""
+        return sum(self._held.pop(ref, {}).values())
+
+    def reservations(self):
+        """Every hold as (ref, sku, quantity), sorted."""
+        return sorted((ref, sku, quantity) for ref, held in self._held.items() for sku, quantity in held.items())
