@@ -0,0 +1,55 @@
+"""A sliding-window rate limiter: at most `limit` requests per key in any `window` seconds."""
+import time
+from collections import deque
+
+
+class SlidingWindowLimiter:
+    """Counts requests per key. A request counted at time t stops counting at exactly t + window.
+
+    `clock` is a function without arguments that returns the current time in seconds; `time.monotonic` when left out.
+    """
+
+    def __init__(self, limit, window, clock=None):
+        if isinstance(limit, bool) or not isinstance(limit, int) or limit < 1:
+            raise ValueError('limit must be a whole number of at least 1')
+        if isinstance(window, bool) or not isinstance(window, (int, float)) or not window > 0:
+            raise ValueError('window must be a number of seconds greater than 0')
+        self.limit = limit
+        self.window = window
+        self._clock = clock if clock is not None else time.monotonic
+        self._counted = {}
+
+    def _inside(self, key, now):
+        """The times of the requests of `key` that still count at `now`, oldest first."""
+        times = self._counted.get(key)
+        if times is None:
+            return ()
+        while times and times[0] + self.window <= now:
+            times.popleft()
+        if not times:
+            del self._counted[key]
+        return times
+
+    def allow(self, key):
+        """Count a request for `key` and return True, or return False when the key is at its limit."""
+        now = self._clock()
+        if len(self._inside(key, now)) >= self.limit:
+            return False
+        self._counted.setdefault(key, deque()).append(now)
+        return True
+
+    def remaining(self, key):
+        """How many more requests `key` could make right now."""
+        return self.limit - len(self._inside(key, self._clock()))
+
+    def retry_after(self, key):
+        """Seconds until `key` may make its next request; 0.0 when it may make one now."""
+        now = self._clock()
+        times = self._inside(key, now)
+        if len(times) < self.limit:
+            return 0.0
+        return float(times[0] + self.window - now)
+
+    def reset(self, key):
+        """Forget everything `key` has done."""
+        self._counted.pop(key, None)
