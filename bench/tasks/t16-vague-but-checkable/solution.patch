new file mode 100644
index 0000000..3e253dc
--- /dev/null
+++ b/mealplan/allergy.py
@@ -0,0 +1,35 @@
+"""Whether a recipe is safe for a customer's allergens.
+
+A recipe contains an allergen when one of its own ingredients is it or contains it (under any name ingredients.py
+knows), or when a component recipe contains it, at any depth.
+"""
+from .ingredients import allergen_group, allergens_in, canonical
+
+
+def wanted_out(profile):
+    """What the customer must never be shown, as allergen groups ('Dairy' -> 'milk'); a name that is not an allergen
+    we know is kept as an ingredient name."""
+    if profile is None:
+        return frozenset()
+    return frozenset(allergen_group(name) or canonical(name) for name in profile.allergens)
+
+
+def contents(book, recipe_id):
+    """Every allergen and every ingredient name in the recipe, components included at any depth."""
+    cache = book.memo.setdefault('contents', {})
+    if recipe_id not in cache:
+        found = set()
+        recipe = book.get(recipe_id)
+        for name, _, _ in recipe.ingredients:
+            found.add(canonical(name))
+            found |= allergens_in(name)
+        for component in recipe.components:
+            found |= contents(book, component)
+        cache[recipe_id] = frozenset(found)
+    return cache[recipe_id]
+
+
+def is_safe(book, recipe_id, profile):
+    """True when the recipe contains nothing in the customer's allergens."""
+    out = wanted_out(profile)
+    return not out or not (out & contents(book, recipe_id))
