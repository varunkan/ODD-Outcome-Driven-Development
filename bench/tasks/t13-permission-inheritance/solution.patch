diff --git a/rolegate/resolver.py b/rolegate/resolver.py
index f8b99ec..52df0f7 100644
--- a/rolegate/resolver.py
+++ b/rolegate/resolver.py
@@ -5,6 +5,19 @@ from .model import ALLOW, NO_MATCH, Decision
 from .patterns import check_resource
 
 
+def decide(rules, action, resource):
+    """The Decision for one request from the user's (role, rule) pairs, nearest first. Deny wins: the first matching
+    deny decides, wherever it is; otherwise the first matching allow; otherwise refused."""
+    allowed = None
+    for role, rule in rules:
+        if rule.applies(action, resource):
+            if rule.effect != ALLOW:
+                return Decision(False, rule.effect, role, rule)
+            if allowed is None:
+                allowed = Decision(True, rule.effect, role, rule)
+    return allowed if allowed is not None else NO_MATCH
+
+
 class Resolver:
     """Reads a Policy and keeps itself up to date by subscribing to it.
 
